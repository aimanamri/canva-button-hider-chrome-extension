{
  "manifest_version": 3,
  "name": "Canva Button Hider",
  "version": "1.1",
  "description": "Hides the 'Send to teacher' button on Canva design pages. Applicable for Canva Education!",
  "permissions": ["scripting"],
  "host_permissions": ["https://www.canva.com/design/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.canva.com/design/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Canva Button Hider"
  }
}
